{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh-assist role v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "persona"
  ],
  "properties": {
    "format": {
      "const": "dsh-assist/role"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "constructor",
          "prototype",
          "com0",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt0",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "persona": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "style": {
      "type": "string",
      "maxLength": 4000
    },
    "greeting": {
      "type": "string",
      "maxLength": 4000
    },
    "memoryPolicy": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
